# Copy to .env and fill in. Any OpenAI-compatible provider works.
PLAYER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PLAYER_API_KEY=
PLAYER_MODEL=gemini-3.1-flash-lite

DM_BASE_URL=https://openrouter.ai/api/v1
DM_API_KEY=
DM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional safety nets
# PLAYER_TOKEN_BUDGET=60000
# DM_TOKEN_BUDGET=20000
